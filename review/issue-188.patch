Subject: [PATCH] fix: include the minus sign in negative-pattern locations

Refs #188
---
 handrolled_parser/parser.mbt                  |   7 +-
 .../manual_test/negative_pattern_loc_test.mbt | 106 ++++++++++++++++++
 untyped_cst/internal/lower/pattern.mbt        |  12 +-
 3 files changed, 111 insertions(+), 14 deletions(-)
 create mode 100644 test/manual_test/negative_pattern_loc_test.mbt

diff --git a/handrolled_parser/parser.mbt b/handrolled_parser/parser.mbt
index cb8cad6..7cdd27a 100644
--- a/handrolled_parser/parser.mbt
+++ b/handrolled_parser/parser.mbt
@@ -1848,21 +1848,22 @@ fn State::parse_simple_pattern(self : Self) -> @syntax.Pattern {
       Constant(c=@syntax.make_double(x), loc~)
     }
     MINUS => {
+      let spos = self.peek_spos()
       self.expect_token(TK_MINUS)
       match self.peek_token() {
         INT(x) => {
-          let loc = self.peek_location()
           self.expect_token(TK_INT)
+          let loc = self.loc_start_with(spos)
           Constant(c=@syntax.make_int("-\{x}"), loc~)
         }
         FLOAT(x) => {
-          let loc = self.peek_location()
           self.expect_token(TK_FLOAT)
+          let loc = self.loc_start_with(spos)
           Constant(c=@syntax.make_float("-\{x}"), loc~)
         }
         DOUBLE(x) => {
-          let loc = self.peek_location()
           self.expect_token(TK_DOUBLE)
+          let loc = self.loc_start_with(spos)
           Constant(c=@syntax.make_double("-\{x}"), loc~)
         }
         other => {
diff --git a/test/manual_test/negative_pattern_loc_test.mbt b/test/manual_test/negative_pattern_loc_test.mbt
new file mode 100644
index 0000000..d2ee541
--- /dev/null
+++ b/test/manual_test/negative_pattern_loc_test.mbt
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: Apache-2.0
+
+///|
+struct PatternFragments {
+  source : String
+  fragments : Array[String]
+}
+
+///|
+extend PatternFragments with @syntax.IterVisitor::{visit_Impl}
+
+///|
+impl @syntax.IterVisitor for PatternFragments with fn visit_Pattern_Constant(
+  self,
+  c~,
+  loc~,
+) {
+  ignore(c)
+  self.fragments.push(self.source[loc.start.cnum:loc.end.cnum].to_owned())
+}
+
+///|
+fn checked_pattern_fragments(
+  source : String,
+  impls : @syntax.Impls,
+  expected : Array[String],
+) -> Json raise Error {
+  let visitor : PatternFragments = { source, fragments: [], }
+  for impl_ in impls {
+    visitor.visit_Impl(impl_)
+  }
+  @test.assert_eq(visitor.fragments, expected)
+  @basic.show_loc.protect(String, fn() {
+    ToJson::to_json(impls.map(impl_ => impl_.json_repr()))
+  })
+}
+
+///|
+fn assert_pattern_locations(
+  source : String,
+  expected : Array[String],
+) -> Unit raise Error {
+  let (hand, hand_reports) = @parser.parse_string(source, parser=Handrolled)
+  let (yacc, yacc_reports) = @parser.parse_string(source, parser=MoonYacc)
+  let cst = @untyped_cst.parse_structure(source)
+  let (lowered, lower_reports) = cst.to_impls()
+  @test.assert_eq(hand_reports.length(), 0)
+  @test.assert_eq(yacc_reports.length(), 0)
+  @test.assert_eq(cst.diagnostics_view().length(), 0)
+  @test.assert_eq(lower_reports.length(), 0)
+  let hand_json = checked_pattern_fragments(source, hand, expected)
+  let yacc_json = checked_pattern_fragments(source, yacc, expected)
+  let cst_json = checked_pattern_fragments(source, lowered, expected)
+  @test.assert_eq(hand_json, yacc_json)
+  @test.assert_eq(hand_json, cst_json)
+}
+
+///|
+test "negative integer patterns include the sign" {
+  assert_pattern_locations(
+    "fn f(x) { match x { (-1, -1L, -0x10) => 1; _ => 0 } }",
+    ["-1", "-1L", "-0x10"],
+  )
+}
+
+///|
+test "negative floating patterns include the sign" {
+  assert_pattern_locations(
+    "fn f(x) { match x { (-1.5, -1.5F) => 1; _ => 0 } }",
+    ["-1.5", "-1.5F"],
+  )
+}
+
+///|
+test "negative pattern spans retain intervening whitespace" {
+  assert_pattern_locations("fn f(x) { match x { -  1 => 1; _ => 0 } }", ["-  1"])
+}
+
+///|
+test "negative range endpoints retain their signs" {
+  assert_pattern_locations("fn f(x) { match x { -3..=-1 => 1; _ => 0 } }", [
+    "-3", "-1",
+  ])
+}
+
+///|
+test "negative alternative patterns retain their signs" {
+  assert_pattern_locations("fn f(x) { match x { -1 | -2 => 1; _ => 0 } }", [
+    "-1", "-2",
+  ])
+}
+
+///|
+test "negative patterns nested in a constructor retain the sign" {
+  assert_pattern_locations("fn f(x) { match x { Some(-1) => 1; _ => 0 } }", [
+    "-1",
+  ])
+}
+
+///|
+test "positive pattern spans remain unchanged" {
+  assert_pattern_locations(
+    "fn f(x) { match x { (1, 1.5, 1.5F) => 1; _ => 0 } }",
+    ["1", "1.5", "1.5F"],
+  )
+}
diff --git a/untyped_cst/internal/lower/pattern.mbt b/untyped_cst/internal/lower/pattern.mbt
index eb374bf..6136c21 100644
--- a/untyped_cst/internal/lower/pattern.mbt
+++ b/untyped_cst/internal/lower/pattern.mbt
@@ -10,17 +10,7 @@ fn lower_pattern(node : CstNode) -> @syntax.Pattern {
     Pattern_Any | Pattern_MissingPattern => Any(loc=node.loc)
     Pattern_Constant =>
       if lower_constant_from_node(node) is Some(c) {
-        let loc = if node.has_child_kind(fn(kind) {
-            kind is Operator_UnaryMinus
-          }) {
-          node
-          .first_child_with_label("semantic_constant")
-          .map(constant => constant.loc)
-          .unwrap_or(node.loc)
-        } else {
-          node.loc
-        }
-        Constant(c~, loc~)
+        Constant(c~, loc=node.loc)
       } else {
         Any(loc=node.loc)
       }
